#!/data/data/com.termux/files/usr/bin/sh
# Wrapper Termux:Tasker pour toggle_filtre_url.py (v2).
# $1 = on / off / toggle / status (défaut : toggle)
#
# Le JSON résultat est écrit dans ~/storage/downloads/roblox_result.json
# et le code de sortie dans ~/storage/downloads/roblox_exit.txt.
# La sortie d'erreur éventuelle va dans ~/storage/downloads/roblox_result.err
# (elle ne doit jamais polluer le JSON).
# Les résultats passent d'abord par des fichiers temporaires, puis un
# renommage atomique (mv dans le même dossier) : Tasker ne lit jamais
# un fichier incomplet si l'exécution est interrompue pendant l'écriture.
python ~/toggle_filtre_url.py "${1:-toggle}" > ~/storage/downloads/.roblox_result.json.tmp 2> ~/storage/downloads/roblox_result.err
echo "$?" > ~/storage/downloads/.roblox_exit.txt.tmp
mv ~/storage/downloads/.roblox_result.json.tmp ~/storage/downloads/roblox_result.json
mv ~/storage/downloads/.roblox_exit.txt.tmp ~/storage/downloads/roblox_exit.txt
